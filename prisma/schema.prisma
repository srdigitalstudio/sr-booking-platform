// Prisma schema for sr-booking-platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String?       @unique
  phone        String?
  appointments Appointment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([email])
  @@index([phone])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  duration     Int
  price        Decimal?      @db.Decimal(10, 2)
  active       Boolean       @default(true)

  appointments Appointment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([active])
}

model Appointment {
  id          String            @id @default(cuid())
  customerId  String
  serviceId   String

  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  date        DateTime
  time        String
  status      AppointmentStatus @default(PENDING)
  notes       String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([customerId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([date, time])
}

model BusinessHour {
  id         String    @id @default(cuid())
  dayOfWeek  DayOfWeek
  isOpen     Boolean   @default(true)
  startTime  String
  endTime    String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([dayOfWeek])
  @@index([dayOfWeek])
}

model BusinessBreak {
  id         String    @id @default(cuid())
  dayOfWeek  DayOfWeek
  startTime  String
  endTime    String
  label      String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([dayOfWeek])
}

model BlockedDate {
  id         String   @id @default(cuid())
  date       DateTime
  reason     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model Settings {
  id                       String            @id @default(cuid())
  businessName             String            @default("SR Booking")
  businessType             String            @default("Booking Platform")
  bookingEnabled           Boolean           @default(true)
  defaultAppointmentStatus AppointmentStatus @default(PENDING)
  bookingNotifications     Boolean           @default(true)
  customerNotifications    Boolean           @default(true)
  language                 String            @default("English")
  currency                 String            @default("USD")

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String

  sessions     Session[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}