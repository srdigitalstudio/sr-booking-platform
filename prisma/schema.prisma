// Prisma schema for sr-booking-platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

model Business {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  timezone    String  @default("UTC")
  currency    String  @default("USD")
  active      Boolean @default(true)

  memberships    BusinessMembership[]
  customers      Customer[]
  services       Service[]
  staff          Staff[]
  appointments   Appointment[]
  businessHours  BusinessHour[]
  businessBreaks BusinessBreak[]
  blockedDates   BlockedDate[]
  settings       Settings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([active])
}

model BusinessMembership {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole @default(STAFF)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([businessId, role])
}

model Customer {
  id         String  @id @default(cuid())
  businessId String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  email        String?
  phone        String?
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, email])
  @@index([businessId])
  @@index([name])
  @@index([email])
  @@index([phone])
}

model Service {
  id         String  @id @default(cuid())
  businessId String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?
  duration    Int
  price       Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([name])
  @@index([active])
  @@index([businessId, active])
}

model Staff {
  id         String  @id @default(cuid())
  businessId String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name   String
  email  String?
  phone  String?
  active Boolean @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, email])
  @@index([businessId])
  @@index([name])
  @@index([active])
  @@index([businessId, active])
}

model Appointment {
  id         String  @id @default(cuid())
  businessId String?
  customerId String
  serviceId  String
  staffId    String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  date   DateTime
  time   String
  status AppointmentStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([customerId])
  @@index([serviceId])
  @@index([staffId])
  @@index([date])
  @@index([status])
  @@index([date, time])
  @@index([businessId, date])
  @@index([businessId, status])
  @@index([businessId, date, time])
}

model BusinessHour {
  id         String  @id @default(cuid())
  businessId String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  isOpen    Boolean   @default(true)
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@index([dayOfWeek])
}

model BusinessBreak {
  id         String  @id @default(cuid())
  businessId String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  label     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([dayOfWeek])
  @@index([businessId, dayOfWeek])
}

model BlockedDate {
  id         String  @id @default(cuid())
  businessId String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  date   DateTime
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, date])
  @@index([businessId])
  @@index([date])
}

model Settings {
  id         String  @id @default(cuid())
  businessId String? @unique

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  businessName             String            @default("SR Booking")
  businessType             String            @default("Booking Platform")
  bookingEnabled           Boolean           @default(true)
  defaultAppointmentStatus AppointmentStatus @default(PENDING)
  bookingNotifications     Boolean           @default(true)
  customerNotifications    Boolean           @default(true)
  language                 String            @default("English")
  currency                 String            @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  sessions    Session[]
  memberships BusinessMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
